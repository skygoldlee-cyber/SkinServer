--- /dev/null
+++ b/03_webstack_스캐폴드/nginx/conf.d/00-hardening.conf
@@ -0,0 +1,10 @@
+# (v3) http 컨텍스트 하드닝 — conf.d/ 는 http 블록 안에 include 되므로
+#      server_tokens·limit_req_zone 같은 http 레벨 지시어를 여기에 둔다.
+#      파일명 00- 접두사로 다른 server 블록보다 먼저 로드되게 한다.
+
+# 응답/에러 페이지에서 nginx 버전 숨김 (핑거프린팅 표면 축소)
+server_tokens off;
+
+# API 레이트리밋 존 (IP 기준). 각 server 의 location 에서 limit_req 로 소비.
+#  - 10m ≈ 약 16만 IP 상태, 평균 10 req/s 로 제한.
+limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
--- /dev/null
+++ b/03_webstack_스캐폴드/nginx/snippets/security-headers.conf
@@ -0,0 +1,8 @@
+# (v3) 공통 보안 헤더 — 각 server 블록에서 include
+#      always 플래그: 4xx/5xx 응답에도 헤더가 붙도록.
+add_header X-Content-Type-Options nosniff always;
+add_header X-Frame-Options DENY always;
+add_header Referrer-Policy strict-origin-when-cross-origin always;
+
+# HTTPS(§22 Caddy/certbot) 적용 후 아래 주석 해제:
+# add_header Strict-Transport-Security "max-age=31536000" always;
