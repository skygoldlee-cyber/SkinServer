+    [ "$c" = 200 ] && ok "$1 HTTP $c" || ng "$1 HTTP $c (200 아님)"
+  else
+    [ "$c" -lt 500 ] && ok "$1 HTTP $c" || ng "$1 HTTP $c (5xx)"
+  fi
