# =============================================================
# Caddyfile — AI Server TLS 종단 (★ 도메인/이메일을 실제 값으로 교체)
#
#  - Caddy 가 HTTP(80)→HTTPS(443) 리다이렉트와 인증서 발급/갱신을 자동 처리.
#  - 웹 정적 표면은 Vercel 로 이관되었으므로, 여기서는 api.example.com 만 프록시.
#  - HSTS·보안헤더는 여기서 1회만 설정(기존 nginx security-headers.conf 책임 이주).
# =============================================================

{
	email admin@example.com          # ← 실제 관리자 메일(만료 알림·ACME)
	# staging 테스트 시 rate limit 회피용:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# AI Server API 전용 — 웹 도메인은 Vercel 에서 처리.
api.example.com {
	encode gzip

	# CORS 프리플라이트·실제 요청을 gateway 로 그대로 전달.
	reverse_proxy gateway:8000 {
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
