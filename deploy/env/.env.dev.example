# =============================================================
# .env.dev — skinlens-dev (Supabase) 전용 템플릿
#   대상 서버: dev/staging (WSL 개발 박스)
#   사용법: 이 파일을 deploy/env/.env 로 복사한 뒤, <...> 부분을 실제 값으로 교체.
#   ★ 절대 커밋 금지. deploy 로 덮어쓰지 않음.
# =============================================================

# ---- 공통 ----
COMPOSE_PROJECT_NAME=skinlens
# REDIS_URL 은 Phase 3(캐시) 도입 시 사용. 현재 큐는 Postgres FOR UPDATE SKIP LOCKED 기반.
# REDIS_URL=redis://redis:6379/0

# ---- DB 연결 (Supabase skinlens-dev) ----
# Supabase Dashboard → Settings → Database → Connection info
#   Host: db.<dev-project-ref>.supabase.co
#   Port: 5432 (직접 연결, DDL/마이그레이션용)
#         6543 (PgBouncer, 장기 연결 worker용 — 선택)
DATABASE_URL=postgresql://postgres:<dev-db-password>@db.<dev-project-ref>.supabase.co:5432/postgres?sslmode=require

# ---- GHCR (엔진 이미지 pull 용) ----
GHCR_OWNER=coteleafdev

# ---- 인증 (Supabase Auth JWT 검증) ----
# Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=<dev-jwt-secret>
JWT_AUD=authenticated
AUTH_MODE=strict

# ---- 스토리지 (Supabase Storage) ----
# Supabase Dashboard → Settings → API → Project URL / service_role key
STORAGE_BACKEND=supabase
SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<dev-service-role-key>
STORAGE_BUCKET=skin-images

# ---- Phase 4: presigned 업로드 전환 ----
ENABLE_LEGACY_UPLOAD=1     # 웹 presigned 전환 확인 후 0 으로 폐기(410)
PRESIGN_EXPIRES_SEC=900    # 서명 업로드 URL 만료(15분)
PRESIGN_RATE_PER_MIN=10    # 사용자당 분당 presign 발급 상한

# ---- 안정·성능 튜닝 (선택 — 미설정 시 각 서비스 기본값) ----
# DB 커넥션 풀(psycopg-pool). 요청·이벤트마다 연결을 새로 열지 않고 재사용해 연결 고갈 방지.
# DB_POOL_MIN=2              # 풀 최소 연결. gateway/worker 공통 기본 2
# DB_POOL_MAX=10             # 풀 최대 연결. gateway 기본 10 / worker 기본 5
# MAX_DOWNLOAD_BYTES=26214400  # worker 가 Supabase 에서 받는 원본 상한(기본 25MB).
#                              # 버킷 file_size_limit 과 같은 값 권장.
# JWT_ISS=                     # JWT 발급자 고정. 비우면 SUPABASE_URL/auth/v1 로 자동 유도(권장)

# (레거시) 로컬 db 를 임시로 쓰려면 아래를 주석 해제하고 compose.dev.yml 에 db 서비스를 되살린다.
# POSTGRES_USER=appuser
# POSTGRES_PASSWORD=CHANGE_ME_strong_pw
# POSTGRES_DB=appdb
# DATABASE_URL=postgresql://appuser:CHANGE_ME_strong_pw@db:5432/appdb
