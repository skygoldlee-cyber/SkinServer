# =============================================================
# .env.images — 각 서비스가 "지금 돌릴 이미지 태그".
#   deploy.sh 가 이 파일의 한 줄만 원자적으로 바꿔 up -d 한다.
#   롤백 = 이전 값으로 되돌려 다시 up -d.
#   이 예시를 .env.images 로 복사해 시작(이후엔 자동 갱신됨).
# =============================================================

# 서버에서 빌드되는 로컬 이미지(sha 태그). 최초엔 latest 로 시작.
GATEWAY_IMAGE=sl_gateway:latest
WORKER_IMAGE=sl_worker:latest

# CI 가 GHCR 로 push 하는 엔진 이미지.
ENGINE_ANALYSIS_IMAGE=ghcr.io/coteleafdev/skinlens-engine-analysis:latest
ENGINE_PRESCRIPTION_IMAGE=ghcr.io/coteleafdev/skinlens-engine-prescription:latest
