# =============================================================
# remote.env — Windows → Linux 원격 운영 접속 설정
#
#   remote.ps1 / remote.cmd 가 서버 접속 정보를 여기서 읽는다.
#   이 파일을 remote.env 로 복사한 뒤 값을 채운다.
#
#     copy deploy\env\remote.env.example deploy\env\remote.env
#
#   ⚠ remote.env 는 비밀(개인키 경로·호스트)을 담을 수 있으므로
#     git 에 커밋하지 않는다 (.gitignore 에 deploy/env/remote.env 추가 권장).
# =============================================================

# 접속 대상 (필수). 다음 둘 중 하나 형식:
#   user@host            예) ubuntu@203.0.113.10  또는  ubuntu@api.example.com
#   ~/.ssh/config 별칭   예) myserver   (config 에 HostName/User/IdentityFile 등록)
RemoteTarget=ubuntu@your.server.example.com

# 서버에서 이 리포가 체크아웃된 위치 (기본 ~/SkinServer)
RemoteDir=~/SkinServer

# SSH 포트 (기본 22 — sshd_config 의 Port 와 일치시킬 것)
# SshPort=22

# 개인키 경로 (생략 시 ssh 기본 규칙 ~/.ssh/id_ed25519 등)
# IdentityFile=C:\Users\you\.ssh\id_ed25519
