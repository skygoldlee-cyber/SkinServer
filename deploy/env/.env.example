# =============================================================
# .env — 박스(스테이징 WSL / 운영 VPS)마다 서버에 두는 비밀·설정.
#   ★ 절대 커밋 금지. deploy 로 덮어쓰지 않음(러너가 건드리지 않는 파일).
#   각 서버에서 이 예시를 .env 로 복사해 값을 채운다.
# =============================================================

# ---- 공통 ----
COMPOSE_PROJECT_NAME=skinlens
# REDIS_URL 은 Phase 3(캐시) 도입 시 사용. 현재 큐는 Postgres FOR UPDATE SKIP LOCKED 기반.
# REDIS_URL=redis://redis:6379/0

# ---- DB 연결 (전 환경 Supabase) ----
# dev/staging/prod 모두 Supabase 프로젝트를 사용한다. 로컬 db 컨테이너는 더 이상 쓰지 않는다.
# Supabase 프로젝트: skinlens-dev (dev/staging), skinlens-prod (prod)
#
# 아래 DATABASE_URL 은 Supabase 프로젝트의 Postgres 연결 문자열로 교체할 것.
#   형식: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#   예시: postgresql://postgres:CHANGE_ME@db.abcdefgh.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.xxxx.supabase.co:5432/postgres?sslmode=require

# (레거시) 로컬 db 를 임시로 쓰려면 아래를 주석 해제하고 compose.dev.yml 에 db 서비스를 되살린다.
# POSTGRES_USER=appuser
# POSTGRES_PASSWORD=CHANGE_ME_strong_pw
# POSTGRES_DB=appdb
# DATABASE_URL=postgresql://appuser:CHANGE_ME_strong_pw@db:5432/appdb

# ---- GHCR (엔진 이미지 pull 용) ----
#   비공개 패키지면 서버가 로그인해야 pull 가능(README 참고).
GHCR_OWNER=coteleafdev

# ---- 인증(운영 strict 필수) ----
#   gateway 가 Authorization: Bearer <JWT> 를 HS256 으로 검증해 사용자(sub=uuid)를 도출한다.
#   Supabase 프로젝트의 JWT Secret 을 넣는다. 없으면 strict 요청은 500(무인증 통과 금지).
#   ※ ENV=prod 에서 AUTH_MODE!=strict 면 gateway 기동 거부(fail-fast).
#   ※ 엣지 nginx 는 클라이언트가 본내 X-User-Id 를 항상 제거한다(위조 차단).
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# JWT_AUD=authenticated
# JWT_ISS=                     # JWT 발급자 고정. 비우면 SUPABASE_URL/auth/v1 로 자동 유도(권장)
# AUTH_MODE=strict            # 운영. dev 는 X-User-Id/폴리 허용(compose.dev 오버레이)

# ---- 스토리지 (Supabase Storage) ----
# STORAGE_BACKEND=supabase 로 전환하면 gateway/worker 가 Supabase Storage 를 사용한다.
# STORAGE_BACKEND=supabase     # local | supabase
# STORAGE_DIR=/data/storage    # STORAGE_BACKEND=local 일 때만 사용
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key>   # 절대 브라우저/외부 노출 금지
# STORAGE_BUCKET=skin-images

# ---- Phase 4: presigned 업로드 전환 ----
# 브라우저가 Supabase Storage 에 직접 PUT, gateway 는 image_key 만 받아 잡 생성.
# 실질 매직바이트 재검증은 worker 가 fetch 직후 수행(P0) — gateway 는 바이트를 안 본다.
# ENABLE_LEGACY_UPLOAD=1   # 구 multipart /analyze 초기 호환. 웹 전환 확인 후 0 으로 폐기(410)
# PRESIGN_EXPIRES_SEC=900  # 서명 업로드 URL 만료(15분). 짧게 유지해 유출 피해 축소
# PRESIGN_RATE_PER_MIN=10  # 사용자당 분당 presign 발급 상한(남용 방지)

# ---- 안정·성능 튜닝 (선택 — 미설정 시 각 서비스 기본값) ----
# DB 커넥션 풀(psycopg-pool). 요청·이벤트마다 연결을 새로 열지 않고 재사용해 Supabase 연결 고갈 방지.
# DB_POOL_MIN=2              # 풀 최소 연결. gateway/worker 공통 기본 2
# DB_POOL_MAX=10             # 풀 최대 연결. gateway 기본 10 / worker 기본 5
# MAX_DOWNLOAD_BYTES=26214400  # worker 가 Supabase 에서 받는 원본 상한(기본 25MB).
#                              # 버킷 file_size_limit 과 같은 값 권장. 스트리밍 초과 시 임시파일 정리.
