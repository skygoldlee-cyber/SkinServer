# Next.js 는 NEXT_PUBLIC_ 접두 변수만 클라이언트 번들에 주입한다.
# anon 키는 공개 키(브라우저 노출 전제)이며, 실제 권한은 Supabase RLS 로 통제된다.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# AI Server(gateway) 의 공개 베이스. 오리진이 다륯므로 gateway 에 CORS 허용 오리진을
# 명시해야 한다(Phase 3 선행 과제). 같은 오리진으로 프록시하면 /api 로 둔다.
# 예: https://api.example.com  (Caddy 가 gateway:8000 앞단 TLS)
NEXT_PUBLIC_AI_API_BASE=/api
